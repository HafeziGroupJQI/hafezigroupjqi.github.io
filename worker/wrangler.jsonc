// Members API for https://hafezigroupjqi.github.io. Browsers never visit this Worker: the site's
// service worker fetches the member edition (the static assets below) through GET /api/site/*
// with a bearer token, alongside the calendar/device APIs and private documents streamed from
// vault-private. Lab PCs call /api/agent/* with device keys.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hafezi-members",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "workers_dev": true,
  "observability": {
    "enabled": true,
  },
  "assets": {
    "directory": "../.cache/private-site",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hafezi-members",
      // Fill in from `wrangler d1 create hafezi-members`.
      "database_id": "55ccb561-e424-45b7-b186-6c29973fdc1f",
      "migrations_dir": "migrations",
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "DEVICE_HUB", "class_name": "DeviceHub" },
      // The Scratchpad's compute relay: one instance the compute host's tunnel dials into.
      { "name": "COMPUTE_RELAY", "class_name": "ComputeRelay" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DeviceHub"] },
    { "tag": "v2", "new_sqlite_classes": ["ComputeRelay"] },
  ],
  // Coarse edge limit on Wolfram runs (optional; the relay enforces 1 concurrent + 30 / 10 min).
  "ratelimits": [
    { "name": "COMPUTE_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
  ],
  "r2_buckets": [{ "binding": "ARTIFACTS", "bucket_name": "hafezi-artifacts" }],
  // Daily audit-log retention sweep (src/audit.ts pruneAudit).
  "triggers": { "crons": ["17 4 * * *"] },
  "vars": {
    "AUTH_MODE": "github",
    "GITHUB_ORG": "HafeziGroupJQI",
    "GITHUB_TEAM": "lab-members",
    "DOCS_REPO": "HafeziGroupJQI/vault-private",
    "PUBLIC_SITE_URL": "https://hafezigroupjqi.github.io",
    // Owners may open and stop members' Scratchpad servers (each open and stop is audited); the
    // compute host has its own switch, COMPUTE_OWNER_ACCESS in /etc/hafezi-compute/tunnel.env.
    "COMPUTE_OWNER_ACCESS": "true",
  },
  // Secrets (wrangler secret put): SESSION_SECRET, GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET,
  // GITHUB_DOCS_TOKEN, and ANTHROPIC_API_KEY for cloud experiment generation. Instrument
  // control now runs through the per-device HafeziAgent + DeviceHub, so the old C2 quick-tunnel
  // gateway secrets (C2_URL, C2_GATEWAY_SECRET, CF_ACCESS_*) are retired.
  // Scratchpad compute: COMPUTE_ASSERTION_SECRET (shared with the compute host; it never gets
  // SESSION_SECRET) and COMPUTE_HOST_KEY_HASH (lowercase hex sha256 of the host's bearer key).
}
